DATABASE_URL=postgresql://donordesk_app:change-me@localhost:5432/donordesk
DATABASE_ADMIN_URL=postgresql://donordesk:change-admin-password@localhost:5432/donordesk
STORAGE_ROOT=../../storage
PORT=4000
HOST=127.0.0.1
AUTH_PROVIDER=oidc
OIDC_ISSUER=http://localhost:8081/realms/donordesk
OIDC_AUDIENCE=donordesk-web
OIDC_JWKS_URI=http://localhost:8081/realms/donordesk/protocol/openid-connect/certs
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
SENTRY_DSN=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Internal service-to-service auth for Kestra/workers -> /internal/* routes.
INTERNAL_TOKEN=change-me-internal-token
INTERNAL_HMAC_SECRET=change-me-internal-hmac-secret
# Google Sign-In (login page) + Drive onboarding. Same OAuth client, two
# redirect URIs. GOOGLE_DRIVE_CLIENT_ID/_SECRET are required for both flows.
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/drive/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_SHARE_EMAIL=donordesk-service@your-project.iam.gserviceaccount.com
PLATFORM_MASTER_KEY=base64-32-byte-aes-key-for-google-drive-token-encryption
# Real email delivery (assignment/comment-mention/deadline-reminder/invitation/
# password-reset notifications). Leave EMAIL_PROVIDER unset to keep the
# current in-app-only (logged) behavior. Set to "postmark" + a real
# POSTMARK_SERVER_TOKEN to also send email — nothing else needs to change,
# every existing notify() call site is unaffected.
EMAIL_PROVIDER=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=notifications@donordesk.online
# Semantic evidence retrieval (pgvector). Leave OPENAI_API_KEY unset to keep
# the current lexical-matching fallback. Requires infra/postgres/pgvector.sql
# applied and `pnpm --filter @donordesk/infrastructure embedding:backfill` run
# once against existing evidence after the key is set.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# AI Reporter (report-quality v4). Keep AI_REPORTER_DRAFT_TIMEOUT_MS and
# AI_REPORTER_CONTRACT_VERSION identical to the worker's values. The HTTP
# timeout defaults to 2 x draft timeout + 30s (draft + feedback retry);
# override with AI_REPORTER_HTTP_TIMEOUT_MS only if the worker budget changes.
AI_REPORTER_DRAFT_TIMEOUT_MS=90000
AI_REPORTER_CONTRACT_VERSION=4
