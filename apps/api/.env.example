DATABASE_URL=postgresql://donordesk_app:change-me@localhost:5432/donordesk
DATABASE_ADMIN_URL=postgresql://donordesk:change-admin-password@localhost:5432/donordesk
STORAGE_ROOT=../../storage
PORT=4000
HOST=127.0.0.1
AUTH_PROVIDER=oidc
OIDC_ISSUER=http://localhost:8081/realms/donordesk
OIDC_AUDIENCE=donordesk-web
OIDC_JWKS_URI=http://localhost:8081/realms/donordesk/protocol/openid-connect/certs
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
SENTRY_DSN=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Internal service-to-service auth for Kestra/workers -> /internal/* routes.
INTERNAL_TOKEN=change-me-internal-token
INTERNAL_HMAC_SECRET=change-me-internal-hmac-secret
# Google Sign-In (login page) + Drive onboarding. Same OAuth client, two
# redirect URIs. GOOGLE_DRIVE_CLIENT_ID/_SECRET are required for both flows.
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/drive/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_SHARE_EMAIL=donordesk-service@your-project.iam.gserviceaccount.com
PLATFORM_MASTER_KEY=base64-32-byte-aes-key-for-google-drive-token-encryption
