# Internal service-to-service auth for Kestra -> workers /v1/* routes.
INTERNAL_TOKEN=change-me-internal-token

# AI Reporter (report-quality v4). Per-LLM-call cap and per-section budget
# (draft + one validator-feedback retry). The API derives its HTTP timeout
# from AI_REPORTER_DRAFT_TIMEOUT_MS (2x + 30s), so set it on both sides.
AI_REPORTER_DRAFT_TIMEOUT_MS=90000
AI_REPORTER_TOTAL_DRAFT_TIMEOUT_MS=200000
# Completion budget; reasoning models spend part of it on <think> output.
AI_REPORTER_MAX_TOKENS=4096
AI_REPORTER_TEMPERATURE=0.2
AI_REPORTER_CONTRACT_VERSION=4

# Provider pacing (process-wide, shared by every report this worker drafts).
# In-flight provider calls; match the provider plan's concurrency limit. The
# api's AI_REPORTER_SECTION_CONCURRENCY should be no higher than this.
AI_REPORTER_MAX_CONCURRENCY=4
# Optional request-start cap per minute (0 = off).
AI_REPORTER_RPM=0
# Shared back-off after a 429 without Retry-After, and retries per section.
AI_REPORTER_429_COOLDOWN_S=5
AI_REPORTER_TRANSIENT_RETRIES=3
# GLM reasoning is off for drafting (prose from verified findings); "enabled" restores it.
AI_REPORTER_THINKING=disabled
# 1 = also spend the feedback retry on style-only issues (banned phrase, length, repetition).
AI_REPORTER_RETRY_ON_STYLE=0
