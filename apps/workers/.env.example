# Internal service-to-service auth for Kestra -> workers /v1/* routes.
INTERNAL_TOKEN=change-me-internal-token

# AI Reporter (report-quality v4). Per-LLM-call cap and per-section budget
# (draft + one validator-feedback retry). The API derives its HTTP timeout
# from AI_REPORTER_DRAFT_TIMEOUT_MS (2x + 30s), so set it on both sides.
AI_REPORTER_DRAFT_TIMEOUT_MS=90000
AI_REPORTER_TOTAL_DRAFT_TIMEOUT_MS=200000
# Completion budget; reasoning models spend part of it on <think> output.
AI_REPORTER_MAX_TOKENS=4096
AI_REPORTER_TEMPERATURE=0.2
AI_REPORTER_CONTRACT_VERSION=4
