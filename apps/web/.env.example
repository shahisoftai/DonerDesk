NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_OIDC_ENABLED=true
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
OIDC_ISSUER=http://localhost:8081/realms/donordesk
OIDC_CLIENT_ID=donordesk-web
APP_URL=http://localhost:3000
# Google Sign-In (shares the Drive OAuth client; must also be set in apps/api)
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
