generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id
  tenantId      String   @unique
  name          String
  organizationType String
  country       String
  sectors       String   // JSON array
  contactName   String
  contactEmail  String
  website       String?
  defaultLanguage String  @default("en")
  logoUrl       String?
  mainOfficeLocation String?
  donorTypesServed String?
  dataResidency String   @default("DEFAULT") // EU | US | AFRICA | ASIA | DEFAULT
  aiEnabled     Boolean  @default(true)
  storageProvider String @default("LOCAL") // LOCAL | GOOGLE_DRIVE | R2
  driveRootFolderId String?
  reportingDefaults String @default("{}") // JSON: OrganizationReportingDefaults
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  projects      Project[]
}

// Platform control-plane records. These are deliberately not tenant users and
// are never accepted by tenant application authorization.
model PlatformAdmin {
  id                String   @id
  email             String   @unique
  name              String
  passwordHash      String
  status            String   @default("PENDING_ACTIVATION")
  totpSecretEncrypted String?
  recoveryCodesHash String   @default("[]")
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PlatformConfiguration {
  id              String   @id
  scopeType       String   @default("GLOBAL")
  scopeId         String?
  category        String
  provider        String
  displayName     String
  enabled         Boolean  @default(false)
  configurationJson String @default("{}")
  secretCiphertext String?
  secretIv        String?
  secretTag       String?
  secretVersion   Int      @default(1)
  lastTestStatus  String?
  lastTestMessage String?
  lastTestedAt    DateTime?
  createdById     String
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scopeType, scopeId, category, provider])
  @@index([category, enabled])
}

model PlatformAuditEvent {
  id          String   @id
  actorId     String
  action      String
  entityType  String
  entityId    String
  oldValue    String?
  newValue    String?
  ipAddress   String?
  userAgent   String?
  prevHash    String   @default("")
  hash        String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model BackupRun {
  id              String   @id
  configurationId String
  status          String
  destination     String
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  sizeBytes       BigInt?
  checksum        String?
  errorMessage    String?
  restoreTestedAt DateTime?
  restoreStatus   String?

  @@index([startedAt])
}

model ConnectorRun {
  id              String   @id
  configurationId String
  tenantId        String
  connectorType   String
  status          String
  cursor          String?
  recordsRead     Int      @default(0)
  recordsCreated  Int      @default(0)
  recordsSkipped  Int      @default(0)
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([tenantId, startedAt])
}

model User {
  id            String   @id
  tenantId      String
  email         String
  name          String
  passwordHash  String
  role          String
  status        String   @default("INVITED")
  lastLoginAt   DateTime?
  assignedProjectIds String @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [tenantId], references: [tenantId])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Invitation {
  id            String   @id
  tenantId      String
  email         String
  role          String
  invitedById   String
  token         String   @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  projectIds    String   @default("[]")
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

model ProjectMember {
  id            String   @id
  tenantId      String
  projectId     String
  userId        String
  role          String
  status        String   @default("ACTIVE")
  assignedById  String
  assignedAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, projectId, userId])
  @@index([tenantId, projectId])
  @@index([tenantId, userId])
}

model Project {
  id                    String   @id
  tenantId              String
  title                 String
  projectCode           String
  donorName             String
  implementingOrganization String
  partnerOrganization   String?
  country               String
  region                String?
  district              String?
  sector                String
  startDate             DateTime
  endDate               DateTime
  budgetAmount          Float?
  budgetCurrency        String?
  reportingFrequency    String
  description           String?
  primaryContactName    String?
  projectManagerId      String?
  meOfficerId           String?
  reportingOfficerId    String?
  status                String   @default("DRAFT")
  workspaceRootId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization    Organization  @relation(fields: [tenantId], references: [tenantId])
  setup           ProjectSetup?
  reportingProfile ReportingProfile?
  logframeItems   LogframeItem[]
  indicators      Indicator[]
  donorTemplates  DonorTemplate[]
  reportingPeriods ReportingPeriod[]
  activityUpdates ActivityUpdate[]
  evidence        EvidenceFile[]
  checklistItems  ChecklistItem[]
  reportDrafts    ReportDraft[]
  exportPackages  ExportPackage[]
  reportPlans     ReportPlan[]
  generationRuns  ReportGenerationRun[]

  @@unique([tenantId, projectCode])
  @@index([tenantId, id])
}

model ProjectSetup {
  id                       String   @id
  tenantId                 String
  projectId                String   @unique
  workspaceProvisionStatus String   @default("PENDING")
  workspaceProvisionError  String?
  provisionAttemptCount    Int      @default(0)
  lastProvisionAttemptAt   DateTime?
  acknowledgedAt           DateTime?
  acknowledgedById         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  project                  Project  @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId])
  @@index([workspaceProvisionStatus])
}

model ReportingProfile {
  id                       String   @id
  tenantId                 String
  projectId                String   @unique
  defaultTemplateId        String?
  language                 String   @default("en")
  tone                     String   @default("FORMAL")
  writingStyle             String?
  audienceNotes            String?
  formattingRulesJson      String   @default("[]")
  specialRequirementsJson  String   @default("[]")
  sectionOverridesJson     String   @default("{}")
  deadlineOffsetDays       Int?
  autoPeriodCreation       Boolean  @default(false)
  version                  Int      @default(1)
  createdById              String
  updatedById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  project                  Project  @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId])
}

model DonorTemplate {
  id              String   @id
  tenantId        String
  projectId       String
  templateName    String
  donorName       String
  reportType      String
  language        String   @default("en")
  requiredAnnexes String   @default("[]")
  notes           String?
  originalFileUrl String?
  extractedRawText String?
  sectionsJson    String   @default("[]")
  version         Int      @default(1)
  uploadedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  @@index([tenantId])
  @@index([projectId])
}

model LogframeItem {
  id          String   @id
  tenantId    String
  projectId   String
  parentId    String?
  level       String
  code        String?
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id])
  indicators Indicator[]
  @@index([tenantId])
  @@index([projectId])
}

model Indicator {
  id                    String   @id
  tenantId              String
  projectId             String
  logframeItemId        String
  code                  String
  name                  String
  type                  String
  baseline              String   @default("")
  target                String   @default("")
  unit                  String?
  meansOfVerification   String?
  dataSource            String?
  frequency             String?
  responsibleUserId     String?
  disaggregationRequired Boolean @default(false)
  semanticsJson         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id])
  logframeItem LogframeItem @relation(fields: [logframeItemId], references: [id])
  updates      IndicatorUpdate[]
  @@index([tenantId])
  @@index([projectId])
  @@index([logframeItemId])
}

model IndicatorUpdate {
  id                    String   @id
  tenantId              String
  indicatorId           String
  reportingPeriodId     String
  periodAchievement     String
  cumulativeAchievement String
  comments              String?
  dataSource            String?
  attachedEvidenceIds   String   @default("[]")
  verificationStatus    String   @default("DRAFT")
  verifiedById          String?
  verifiedAt            DateTime?
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  indicator Indicator @relation(fields: [indicatorId], references: [id])
  @@unique([tenantId, indicatorId, reportingPeriodId])
  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ReportingPeriod {
  id                    String   @id
  tenantId              String
  projectId             String
  donorTemplateId       String?
  donorTemplateVersion  Int?
  donorTemplateMappingId String?
  reportType            String
  startDate             DateTime
  endDate               DateTime
  deadline              DateTime
  internalReviewDeadline DateTime?
  status                String   @default("NOT_STARTED")
  readinessScore        Int      @default(0)
  responsibleOfficerId  String?
  reportingProfileSnapshotJson String @default("{}")
  templateSnapshotJson         String @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project      Project        @relation(fields: [projectId], references: [id])
  drafts       ReportDraft[]
  checklistItems ChecklistItem[]
  activityUpdates ActivityUpdate[]
  evidenceItems   EvidenceFile[]
  exports      ExportPackage[]
  reportPlans  ReportPlan[]
  generationRuns ReportGenerationRun[]

  @@index([tenantId])
  @@index([projectId])
}

model EvidenceFile {
  id                  String   @id
  tenantId            String
  projectId           String
  reportingPeriodId   String?
  fileName            String
  title               String
  fileUrl             String
  fileType            String
  fileSize            Int
  storageProvider     String   @default("LOCAL") // LOCAL | GOOGLE_DRIVE | R2
  driveFileId         String?
  driveWebLink        String?
  storageKey          String?
  evidenceType        String
  activityId          String?
  indicatorId         String?
  location            String?
  activityDate        DateTime?
  uploadedById        String
  verificationStatus  String   @default("UPLOADED")
  confidentialityLevel String  @default("INTERNAL")
  notes               String?
  aiSummary           String?
  extractedText       String?   @db.Text
  aiSuggestedTagsJson String   @default("[]")
  sensitivityWarning  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project         Project?         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([reportingPeriodId])
  @@index([indicatorId])
  @@index([evidenceType])
}

model ActivityUpdate {
  id                    String   @id
  tenantId              String
  projectId             String
  reportingPeriodId     String
  activityTitle         String
  activityDate          DateTime
  location              String?
  outputId              String?
  indicatorId           String?
  participantsTotal     Int?
  participantsMale      Int?
  participantsFemale    Int?
  participantsChildren  Int?
  participantsDisability Int?
  participantsOther     String?
  summary               String
  achievements          String   @default("")
  challenges            String   @default("")
  lessonsLearned        String   @default("")
  nextSteps             String   @default("")
  attachedEvidenceIds   String   @default("[]")
  status                String   @default("DRAFT")
  submittedById         String
  polishedNarrative     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([reportingPeriodId])
}

model ReportDraft {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  title             String
  status            String   @default("DRAFT")
  version           Int      @default(1)
  generatedByAi     Boolean  @default(false)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  sections        ReportSection[]
  claims          ReportClaim[]
  generationRuns  ReportGenerationRun[]
  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ReportSection {
  id                  String   @id
  tenantId            String
  reportDraftId       String
  sectionTitle        String
  sectionOrder        Int
  content             String   @default("")
  sourceReferencesJson String  @default("[]")
  unsupportedClaims   String   @default("[]")
  status              String   @default("NOT_STARTED")
  chartConfigJson     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reportDraft ReportDraft @relation(fields: [reportDraftId], references: [id])
  claims      ReportClaim[]
  @@index([tenantId])
  @@index([reportDraftId])
}

// Feature 20: Report Intelligence Engine — plan, claims, runs, mappings.
model ReportPlan {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  version           Int      @default(1)
  sectionsJson      String   @default("[]")
  styleJson         String   @default("{}")
  generatedBy       String   @default("INFERRED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@unique([tenantId, reportingPeriodId, version])
  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ReportClaim {
  id                  String   @id
  tenantId            String
  projectId           String
  reportDraftId       String
  sectionId           String
  text                String   @db.Text
  type                String
  sourcesJson         String   @default("[]")
  verificationResult  String   @default("FAILED")
  verificationDetail  String   @default("")
  resolutionNotes     String?
  resolvedById        String?
  resolvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reportDraft ReportDraft @relation(fields: [reportDraftId], references: [id])
  section     ReportSection @relation(fields: [sectionId], references: [id])
  @@index([tenantId])
  @@index([reportDraftId])
  @@index([sectionId])
}

model ReportGenerationRun {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  draftId           String
  snapshotJson      String   @db.Text
  createdAt         DateTime @default(now())

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  reportDraft     ReportDraft     @relation(fields: [draftId], references: [id])
  @@index([tenantId])
  @@index([reportingPeriodId])
  @@index([draftId])
}

model DonorTemplateMapping {
  id            String   @id
  tenantId      String
  templateId    String
  version       Int      @default(1)
  regionsJson   String   @default("[]")
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, templateId, version])
  @@index([tenantId])
  @@index([templateId])
}

model ChecklistItem {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  type              String
  title             String
  description       String   @default("")
  severity          String
  relatedEntityType String?
  relatedEntityId   String?
  assignedToId      String?
  dueDate           DateTime?
  status            String   @default("OPEN")
  resolutionNotes   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ExportPackage {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  exportType        String
  fileUrl           String
  version           Int
  exportedById      String
  includedFiles     String   @default("[]")
  createdAt         DateTime @default(now())

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  @@index([tenantId])
}

model Comment {
  id              String   @id
  tenantId        String
  entityType      String
  entityId        String
  commentText     String
  authorId        String
  mentionedUserId String?
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([entityType, entityId])
}

model Notification {
  id                String   @id
  tenantId          String
  recipientId       String
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([recipientId])
}

model AuditEvent {
  id          String   @id
  tenantId    String
  actorId     String
  eventType   String
  entityType  String
  entityId    String
  projectId   String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  systemNote  String?
  prevHash    String   @default("")
  hash        String   @default("")
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

model LlmModel {
  id          String   @id
  name        String
  provider    String   // openai | anthropic | bedrock | ollama
  version     String
  capabilities String  // JSON array: ["chat", "embedding", "vision"]
  costPer1kTokens Float @default(0)
  maxTokens   Int     @default(4096)
  jurisdiction String  @default("US") // US | EU | AFRICA | ASIA
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  llmRuns     LlmRun[]
  prompts     LlmPrompt[]

  @@index([provider])
  @@index([jurisdiction])
}

model LlmPrompt {
  id          String   @id
  name        String   // e.g., "evidence-tagger", "report-drafter"
  version     Int      @default(1)
  promptText  String   @db.Text
  variables   String   // JSON array of variable names
  modelId     String?
  model       LlmModel? @relation(fields: [modelId], references: [id])
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  llmRuns     LlmRun[]
  feedback    LlmFeedback[]

  @@unique([name, version])
  @@index([name])
}

model LlmRun {
  id              String   @id
  modelId         String
  model           LlmModel @relation(fields: [modelId], references: [id])
  promptId       String
  prompt          LlmPrompt @relation(fields: [promptId], references: [id])
  tenantId       String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  costUsd         Float    @default(0)
  latencyMs       Int      @default(0)
  status          String   @default("success") // success | error | timeout
  errorMessage    String?
  responseText    String?  @db.Text
  promptVersion   Int
  modelVersion    String
  operationType   String?  // REPORT_DRAFT | EVIDENCE_TAG | ACTIVITY_POLISH
  resourceId      String?  // report draft / evidence / activity id
  billableUnits   Int      @default(0)
  requestId       String?  // caller idempotency key
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, operationType, createdAt])
  @@index([resourceId])
  @@index([requestId])
  @@index([modelId])
  @@index([promptId])
  @@index([createdAt])
}

model LlmFeedback {
  id          String   @id
  promptId    String
  prompt      LlmPrompt @relation(fields: [promptId], references: [id])
  tenantId    String
  runId       String?
  taskType    String   // evidence_tagging | report_draft | activity_polish
  entityType  String?  // evidence | report_section | activity_update
  entityId    String?
  accepted    Boolean
  rating      Int?     // 1-5 optional rating
  comment     String?
  modelId     String?
  promptVersion Int?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([taskType])
  @@index([entityType, entityId])
  @@index([accepted])
}

model EvidenceChunk {
  id          String   @id
  evidenceId  String
  tenantId    String
  chunkIndex  Int
  text        String   @db.Text
  tokenCount  Int      @default(0)
  createdAt   DateTime @default(now())

  embeddings  EvidenceEmbedding[]

  @@index([evidenceId])
  @@index([tenantId])
}

model EvidenceEmbedding {
  id          String   @id
  chunkId     String
  chunk       EvidenceChunk @relation(fields: [chunkId], references: [id])
  tenantId    String
  modelId     String
  provider    String
  vector      String   // JSON array of floats (stored as string for pgvector compatibility)
  dimensions  Int
  createdAt   DateTime @default(now())

  @@index([chunkId])
  @@index([tenantId])
}

////////////////////////////////////////////////////////////////////////////////
// PHASE 5: Enterprise & Sector Intelligence
////////////////////////////////////////////////////////////////////////////////

model SectorTemplatePack {
  id              String   @id
  tenantId        String
  organizationId  String
  name            String
  sector          String   // NUTRITION | FOOD_SECURITY | WASH | HEALTH | PROTECTION | EDUCATION | LIVELIHOODS | SHELTER | MULTI_SECTOR | OTHER
  version         Int      @default(1)
  description     String
  donorName       String
  reportType      String
  language        String   @default("en")
  status          String   @default("DRAFT") // DRAFT | PUBLISHED | DEPRECATED
  indicatorTemplatesJson String @default("[]") // JSON array of IndicatorTemplate
  logframeTemplatesJson String @default("[]") // JSON array of LogframeNodeTemplate
  complianceTemplatesJson String @default("[]") // JSON array of ComplianceChecklistTemplate
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([organizationId])
  @@index([sector])
  @@index([status])
}

model ProjectRiskTrend {
  id                    String   @id
  tenantId              String
  projectId             String
  periodStart           DateTime
  periodEnd             DateTime
  riskScore             Int      @default(0)
  riskLevel             String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  contributingFactorsJson String @default("[]") // JSON array of RiskFactor
  missingEvidenceCount  Int      @default(0)
  deadlineSlipsCount    Int      @default(0)
  overdueChecklistItemsCount Int @default(0)
  lastUpdated           DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([tenantId])
  @@index([projectId])
  @@index([riskLevel])
  @@index([tenantId, riskLevel])
}

model OrganizationBranding {
  id                    String   @id
  tenantId              String
  organizationId        String   @unique
  enabled               Boolean  @default(true)
  subdomain             String?
  brandingConfigJson    String   @default("{}") // JSON: { logoUrl, faviconUrl, brandColorPrimary, brandColorSecondary, brandColorAccent, fontFamilyHeading, fontFamilyBody, emailSenderName, emailSenderAddress, customDomain, customDomainVerified, privacyPolicyUrl, termsOfServiceUrl }
  dmarCStatus           String   @default("none") // pending | valid | invalid | none
  dkimStatus            String   @default("pending")
  spfStatus             String   @default("pending")
  customSSLCert         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
}

model LessonPattern {
  id                  String   @id
  tenantId            String
  sector              String   // NUTRITION | FOOD_SECURITY | WASH | HEALTH | PROTECTION | EDUCATION | LIVELIHOODS | SHELTER | MULTI_SECTOR | OTHER
  donorName           String
  patternType         String   // recurring_challenge | mitigation_success | best_practice | risk_signal
  title               String
  description         String
  frequency           Int      @default(1)
  projectsAffectedJson String @default("[]") // JSON array of project IDs
  mitigationStrategiesJson String @default("[]") // JSON array of mitigation strategy descriptions
  evidenceReferencesJson String @default("[]") // JSON array of evidence IDs
  firstObserved       DateTime
  lastObserved        DateTime
  confidence          Int      @default(0) // 0-100
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([sector])
  @@index([donorName])
  @@index([patternType])
  @@index([tenantId, sector, donorName])
}

model ABACFieldPolicy {
  id                  String   @id
  tenantId            String
  organizationId      String
  role                String   // Role to which policy applies
  resourceType        String   // Project | ActivityUpdate | Indicator | EvidenceFile | etc.
  fieldPoliciesJson   String   // JSON array of FieldPolicy { fieldPath, permission, conditions }
  priority            Int      @default(0) // Higher priority wins when multiple policies match
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, organizationId, role, resourceType])
  @@index([tenantId])
  @@index([resourceType])
}

model MultiRegionBookmark {
  id                  String   @id
  tenantId            String
  region              String   // us-east-1 | eu-west-1 | af-south-1 | ap-southeast-1
  entityType          String   // The type of entity being tracked
  entityId            String
  vectorClockJson     String   @default("[]") // JSON array of VectorClock { region, timestamp, counter }
  lastSyncedAt        DateTime
  syncStatus          String   @default("active") // active | syncing | error
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, region, entityType, entityId])
  @@index([tenantId])
  @@index([entityType, entityId])
}

model IdempotencyRecord {
  id         String   @id
  tenantId   String
  key        String
  jobName    String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, jobName])
}

////////////////////////////////////////////////////////////////////////////////
// FEATURE 19: Tiers, entitlements, and payments
////////////////////////////////////////////////////////////////////////////////

model BillingSubscription {
  id                     String   @id
  tenantId               String
  provider               String   @default("CREEM")
  providerCustomerId     String
  providerSubscriptionId String
  providerProductId      String
  planCode               String
  catalogVersion         Int      @default(1)
  status                 String   @default("ACTIVE") // ACTIVE | TRIALING | PAST_DUE | UNPAID | CANCELLED | EXPIRED | PAUSED
  currency               String   @default("USD")
  unitAmountMinor        Int      @default(0)
  billingInterval        String   @default("MONTH") // MONTH | YEAR
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  canceledAt             DateTime?
  graceEndsAt            DateTime?
  providerUpdatedAt      DateTime?
  lastSyncedAt           DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([tenantId, status])
  @@index([tenantId, providerCustomerId])
  @@index([providerSubscriptionId])
}

model EntitlementGrant {
  id                     String   @id
  tenantId               String
  planCode               String
  source                 String   // DEFAULT | TRIAL | CREEM_SUBSCRIPTION | ENTERPRISE_CONTRACT | GRANDFATHERED | MANUAL
  effectiveFrom          DateTime
  effectiveUntil         DateTime?
  billingSubscriptionId  String?
  overrideLimitsJson     String?  // JSON PlanLimitsJson (enterprise/grandfather)
  reason                 String?
  createdById            String?
  createdAt              DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, source])
  @@index([tenantId, effectiveFrom, effectiveUntil])
  @@index([billingSubscriptionId])
}

model BillingEventInbox {
  id                String   @id
  provider          String   @default("CREEM")
  providerEventId   String
  eventType         String
  providerCreatedAt DateTime?
  tenantId          String?
  payloadChecksum   String
  status            String   @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | FAILED | IGNORED
  attemptCount      Int      @default(0)
  lastError         String?
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerEventId])
  @@index([status])
  @@index([tenantId])
  @@index([createdAt])
}

model UsageCounter {
  id          String   @id
  tenantId    String
  metric      String   // MANAGED_STORAGE_BYTES | AI_DRAFT_CREDITS
  periodStart DateTime
  used        BigInt   @default(0)
  reserved    BigInt   @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId, metric])
}

model TrialIdentity {
  id                String   @id
  tenantId          String
  emailFingerprint  String
  domainFingerprint String
  trialStartedAt    DateTime
  trialEndedAt      DateTime?
  createdAt         DateTime @default(now())

  @@unique([emailFingerprint])
  @@index([domainFingerprint])
  @@index([tenantId])
}
