generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id
  tenantId      String   @unique
  name          String
  organizationType String
  country       String
  sectors       String   // JSON array
  contactName   String
  contactEmail  String
  website       String?
  defaultLanguage String  @default("en")
  /// IANA zone; the daily summary goes out at 07:00 here. Default UTC.
  timeZone      String   @default("UTC")
  logoUrl       String?
  mainOfficeLocation String?
  donorTypesServed String?
  dataResidency String   @default("DEFAULT") // EU | US | AFRICA | ASIA | DEFAULT
  aiEnabled     Boolean  @default(true)
  storageProvider String @default("LOCAL") // LOCAL | GOOGLE_DRIVE | R2
  driveRootFolderId String?
  reportingDefaults String @default("{}") // JSON: OrganizationReportingDefaults
  /// Agent Memory (Phase 21) tenant self-service toggle. Effective state is
  /// this AND the platform AGENT_MEMORY_ENABLED flag.
  agentMemoryEnabled Boolean @default(false)
  /// Set when a NonprofitVerification for this tenant is APPROVED (Phase 22 WS-G).
  nonprofitVerifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  projects      Project[]
}

/// A tenant's submission for the verified nonprofit discount (Phase 22 WS-G).
model NonprofitVerification {
  id                  String    @id
  tenantId            String
  registrationNumber  String
  documentUrl         String
  /// PENDING | APPROVED | REJECTED
  status              String    @default("PENDING")
  submittedAt         DateTime  @default(now())
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

// Platform control-plane records. These are deliberately not tenant users and
// are never accepted by tenant application authorization.
model PlatformAdmin {
  id                String   @id
  email             String   @unique
  name              String
  passwordHash      String
  status            String   @default("PENDING_ACTIVATION")
  totpSecretEncrypted String?
  recoveryCodesHash String   @default("[]")
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PlatformConfiguration {
  id              String   @id
  scopeType       String   @default("GLOBAL")
  scopeId         String?
  category        String
  provider        String
  displayName     String
  enabled         Boolean  @default(false)
  configurationJson String @default("{}")
  secretCiphertext String?
  secretIv        String?
  secretTag       String?
  secretVersion   Int      @default(1)
  lastTestStatus  String?
  lastTestMessage String?
  lastTestedAt    DateTime?
  createdById     String
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scopeType, scopeId, category, provider])
  @@index([category, enabled])
}

model PlatformAuditEvent {
  id          String   @id
  actorId     String
  action      String
  entityType  String
  entityId    String
  oldValue    String?
  newValue    String?
  ipAddress   String?
  userAgent   String?
  prevHash    String   @default("")
  hash        String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model BackupRun {
  id              String   @id
  configurationId String
  status          String
  destination     String
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  sizeBytes       BigInt?
  checksum        String?
  errorMessage    String?
  restoreTestedAt DateTime?
  restoreStatus   String?

  @@index([startedAt])
}

model ConnectorRun {
  id              String   @id
  configurationId String
  tenantId        String
  connectorType   String
  status          String
  cursor          String?
  recordsRead     Int      @default(0)
  recordsCreated  Int      @default(0)
  recordsSkipped  Int      @default(0)
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([tenantId, startedAt])
}

model User {
  id            String   @id
  tenantId      String
  email         String
  name          String
  passwordHash  String
  role          String
  status        String   @default("INVITED")
  lastLoginAt   DateTime?
  assignedProjectIds String @default("[]")
  passwordChangedAt DateTime?
  failedLoginCount Int @default(0)
  lockedUntil   DateTime?
  /// An outside implementing partner: reaches only the projects they are a member of, through an allow-listed set of routes.
  external      Boolean  @default(false)
  /// How the person wants to be emailed: DAILY_SUMMARY (default), URGENT_ONLY, NEVER.
  emailSummaryMode String @default("DAILY_SUMMARY")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [tenantId], references: [tenantId])
  passwordResetTokens PasswordResetToken[]
  @@unique([tenantId, email])
  @@index([tenantId])
}

model PasswordResetToken {
  id          String   @id
  tenantId    String
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tenantId, userId])
  @@index([expiresAt])
}

model Invitation {
  id            String   @id
  tenantId      String
  email         String
  role          String
  invitedById   String
  token         String   @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  external   Boolean  @default(false)
  projectIds    String   @default("[]")
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

/// A credential an identity provider uses to provision this organisation's
/// users over SCIM. Only the hash of the token is stored.
model ScimCredential {
  id          String   @id
  tenantId    String
  name        String
  tokenHash   String   @unique
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model ProjectMember {
  id            String   @id
  tenantId      String
  projectId     String
  userId        String
  role          String
  status        String   @default("ACTIVE")
  assignedById  String
  assignedAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, projectId, userId])
  @@index([tenantId, projectId])
  @@index([tenantId, userId])
}

model Project {
  id                    String   @id
  tenantId              String
  title                 String
  projectCode           String
  donorName             String
  implementingOrganization String
  partnerOrganization   String?
  country               String
  region                String?
  district              String?
  sector                String
  startDate             DateTime
  endDate               DateTime
  budgetAmount          Float?
  budgetCurrency        String?
  reportingFrequency    String
  description           String?
  primaryContactName    String?
  projectManagerId      String?
  meOfficerId           String?
  reportingOfficerId    String?
  status                String   @default("DRAFT")
  workspaceRootId       String?
  archivedAt            DateTime?
  isDemo                Boolean  @default(false)
  /// Admin setting: false hides the work plan screens and keeps the data.
  showWorkPlanning      Boolean  @default(true)
  timeZone              String?
  /// Optional funding hierarchy (programme > grant > project); managed by the funding repository, never by Project.update.
  programmeId           String?
  grantId               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization    Organization  @relation(fields: [tenantId], references: [tenantId])
  setup           ProjectSetup?
  plannedActivities PlannedActivity[]
  projectTasks    ProjectTask[]
  projectRisks    ProjectRisk[]
  reportingProfile ReportingProfile?
  logframeItems   LogframeItem[]
  indicators      Indicator[]
  donorTemplates  DonorTemplate[]
  reportingPeriods ReportingPeriod[]
  activityUpdates ActivityUpdate[]
  evidence        EvidenceFile[]
  checklistItems  ChecklistItem[]
  reportDrafts    ReportDraft[]
  exportPackages  ExportPackage[]
  reportPlans     ReportPlan[]
  generationRuns  ReportGenerationRun[]

  @@unique([tenantId, projectCode])
  @@index([tenantId, id])
  @@index([tenantId, isDemo])
}

model ProjectSetup {
  id                       String   @id
  tenantId                 String
  projectId                String   @unique
  workspaceProvisionStatus String   @default("PENDING")
  workspaceProvisionError  String?
  provisionAttemptCount    Int      @default(0)
  lastProvisionAttemptAt   DateTime?
  acknowledgedAt           DateTime?
  acknowledgedById         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  project                  Project  @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId])
  @@index([workspaceProvisionStatus])
}

model ReportingProfile {
  id                       String   @id
  tenantId                 String
  projectId                String   @unique
  /// Days after a period ends that its indicator values are due (default 5).
  indicatorEntryDueDays    Int      @default(5)
  defaultTemplateId        String?
  language                 String   @default("en")
  tone                     String   @default("FORMAL")
  writingStyle             String?
  audienceNotes            String?
  formattingRulesJson      String   @default("[]")
  specialRequirementsJson  String   @default("[]")
  sectionOverridesJson     String   @default("{}")
  deadlineOffsetDays       Int?
  autoPeriodCreation       Boolean  @default(false)
  /// DISABLED | TYPED | IMPORT: how this project's reports get their financial figures.
  financeDataMode          String   @default("DISABLED")
  /// JSON {reportType: templateId}: the template a new period of that type starts from.
  defaultTemplateByTypeJson String  @default("{}")
  /// When on, the author of a report cannot approve it.
  requireSecondApprover    Boolean  @default(false)
  /// JSON {key: text}: statements that hold for every period (branding policy, waste procedure).
  standingStatementsJson   String   @default("{}")
  version                  Int      @default(1)
  createdById              String
  updatedById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  project                  Project  @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId])
}

model DonorTemplate {
  id              String   @id
  tenantId        String
  projectId       String
  templateName    String
  donorName       String
  reportType      String
  language        String   @default("en")
  requiredAnnexes String   @default("[]")
  notes           String?
  originalFileUrl String?
  extractedRawText String?
  sectionsJson    String   @default("[]")
  /// Structured template-level requirements (submission, formatting, annexes, compliance, AI guidance).
  requirementsJson String  @default("{}")
  /// EXTRACTING | NEEDS_REVIEW | REVIEWED | EXTRACTION_FAILED. Pre-existing rows are REVIEWED.
  status          String   @default("REVIEWED")
  extractionMetaJson String?
  originalFileName String?
  originalFileMime String?
  originalFileHash String?
  isLibrary       Boolean  @default(false)
  sourceTemplateId String?
  version         Int      @default(1)
  uploadedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id])
  versions DonorTemplateVersion[]
  @@index([tenantId])
  @@index([projectId])
  @@index([tenantId, isLibrary])
}

/// Immutable snapshot of a donor template's structure per version; reporting
/// periods pin one version so later edits never change in-flight reports.
model DonorTemplateVersion {
  id               String   @id
  tenantId         String
  templateId       String
  version          Int
  sectionsJson     String   @db.Text
  requirementsJson String   @db.Text
  createdById      String
  changeNote       String?
  createdAt        DateTime @default(now())

  template DonorTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  @@unique([templateId, version])
  @@index([tenantId])
}

model LogframeItem {
  id          String   @id
  tenantId    String
  projectId   String
  parentId    String?
  level       String
  code        String?
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id])
  indicators Indicator[]
  @@index([tenantId])
  @@index([projectId])
}

model Indicator {
  id                    String   @id
  tenantId              String
  projectId             String
  logframeItemId        String
  code                  String
  name                  String
  type                  String
  baseline              String   @default("")
  target                String   @default("")
  unit                  String?
  meansOfVerification   String?
  dataSource            String?
  frequency             String?
  responsibleUserId     String?
  disaggregationRequired Boolean @default(false)
  semanticsJson         String?
  targetBreakdownsJson  String?
  archivedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id])
  logframeItem LogframeItem @relation(fields: [logframeItemId], references: [id])
  updates      IndicatorUpdate[]
  @@index([tenantId])
  @@index([projectId])
  @@index([logframeItemId])
}

model IndicatorUpdate {
  id                    String   @id
  tenantId              String
  indicatorId           String
  reportingPeriodId     String
  periodAchievement     String
  cumulativeAchievement String
  comments              String?
  reviewNote            String? // the reviewer's reason for a correction/rejection; never overwritten by a save
  dataSource            String?
  attachedEvidenceIds   String   @default("[]")
  disaggregationJson    String   @default("[]") // JSON array of DisaggregationEntry
  verificationStatus    String   @default("DRAFT")
  verifiedById          String?
  verifiedAt            DateTime?
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  indicator Indicator @relation(fields: [indicatorId], references: [id])
  @@unique([tenantId, indicatorId, reportingPeriodId])
  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ReportingPeriod {
  id                    String   @id
  tenantId              String
  projectId             String
  donorTemplateId       String?
  donorTemplateVersion  Int?
  donorTemplateMappingId String?
  reportType            String
  startDate             DateTime
  endDate               DateTime
  deadline              DateTime
  internalReviewDeadline DateTime?
  status                String   @default("NOT_STARTED")
  readinessScore        Int      @default(0)
  responsibleOfficerId  String?
  reportingProfileSnapshotJson String @default("{}")
  templateSnapshotJson         String @default("{}")
  storyContextJson             String @default("{}")
  scopeJson                    String @default("{}")
  /// Set when the period was cancelled: its data stays, it leaves the calendar and the closing report.
  cancelledAt                  DateTime?
  cancelReason                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project      Project        @relation(fields: [projectId], references: [id])
  drafts       ReportDraft[]
  checklistItems ChecklistItem[]
  activityUpdates ActivityUpdate[]
  evidenceItems   EvidenceFile[]
  exports      ExportPackage[]
  reportPlans  ReportPlan[]
  generationRuns ReportGenerationRun[]

  @@index([tenantId])
  @@index([projectId])
}

model EvidenceFile {
  id                  String   @id
  tenantId            String
  projectId           String
  reportingPeriodId   String?
  fileName            String
  title               String
  fileUrl             String
  fileType            String
  fileSize            Int
  storageProvider     String   @default("LOCAL") // LOCAL | GOOGLE_DRIVE | R2
  driveFileId         String?
  driveWebLink        String?
  storageKey          String?
  evidenceType        String
  activityId          String?
  /// The indicator this file is about (never an indicator-update id: see indicatorUpdateId).
  indicatorId         String?
  /// The indicator update (one indicator's value for one period) this file is attached to as proof.
  indicatorUpdateId   String?
  location            String?
  activityDate        DateTime?
  uploadedById        String
  verificationStatus  String   @default("UPLOADED")
  confidentialityLevel String  @default("INTERNAL")
  notes               String?
  aiSummary           String?
  extractedText       String?   @db.Text
  textExtractionStatus String? // EXTRACTED | EMPTY | FAILED | UNSUPPORTED; null = not attempted yet
  textExtractionNote  String?
  aiSuggestedTagsJson String   @default("[]")
  sensitivityWarning  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project         Project?         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([reportingPeriodId])
  @@index([indicatorId])
  @@index([indicatorUpdateId])
  @@index([evidenceType])
}

model ActivityUpdate {
  id                    String   @id
  tenantId              String
  projectId             String
  reportingPeriodId     String
  activityTitle         String
  activityDate          DateTime
  /// Last day when the record covers a span (a whole month of clinics); null = it happened on activityDate.
  activityEndDate       DateTime?
  location              String?
  outputId              String?
  /// The logframe's own ACTIVITY node this record delivers (outputId is its parent output).
  logframeActivityId    String?
  /// The planned activity (work plan) this completed activity delivers.
  plannedActivityId     String?
  indicatorId           String?
  participantsTotal     Int?
  participantsMale      Int?
  participantsFemale    Int?
  participantsChildren  Int?
  participantsDisability Int?
  participantsOther     String?
  summary               String
  achievements          String   @default("")
  challenges            String   @default("")
  lessonsLearned        String   @default("")
  nextSteps             String   @default("")
  attachedEvidenceIds   String   @default("[]")
  status                String   @default("DRAFT")
  submittedById         String
  polishedNarrative     String?
  /// The record that replaced this one when it was withdrawn.
  supersededById        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([reportingPeriodId])
  @@index([logframeActivityId])
  @@index([plannedActivityId])
}

model ReportDraft {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  title             String
  status            String   @default("DRAFT")
  version           Int      @default(1)
  generatedByAi     Boolean  @default(false)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  supersededAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  sections        ReportSection[]
  claims          ReportClaim[]
  generationRuns  ReportGenerationRun[]
  @@index([tenantId])
  @@index([reportingPeriodId])
  @@index([supersededAt])
}

model ReportSection {
  id                  String   @id
  tenantId            String
  reportDraftId       String
  sectionTitle        String
  sectionOrder        Int
  /// Heading depth 1-4 (1 = section, 2-4 = sub-sections), from the template section.
  level               Int      @default(1)
  /// Donor numbering as printed in the template ("2.1", "Annex II").
  numbering           String?
  templateSectionId   String?
  content             String   @default("")
  sourceReferencesJson String  @default("[]")
  unsupportedClaims   String   @default("[]")
  status              String   @default("NOT_STARTED")
  chartConfigJson     String?
  currentRevisionId   String?
  /// Why the current text was not written by the AI (a GenerationFallbackReason); null when it was or a person wrote it.
  generationFallbackReason String?
  /// Short, user-safe detail for the reason ("figure not in your data: 33.3%").
  generationFallbackDetail String?
  /// When a person confirmed the summary still matches the report (clears the "may be out of date" notice).
  summaryCurrentAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reportDraft ReportDraft @relation(fields: [reportDraftId], references: [id])
  claims      ReportClaim[]
  revisions   ReportRevision[]
  artifacts   ReportArtifact[]
  @@index([tenantId])
  @@index([reportDraftId])
}

// Feature 20: Report Intelligence Engine — plan, claims, runs, mappings.
model ReportPlan {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  version           Int      @default(1)
  sectionsJson      String   @default("[]")
  styleJson         String   @default("{}")
  generatedBy       String   @default("INFERRED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@unique([tenantId, reportingPeriodId, version])
  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ReportClaim {
  id                     String   @id
  tenantId               String
  projectId              String
  reportDraftId          String
  sectionId              String
  text                   String   @db.Text
  type                   String
  sourcesJson            String   @default("[]")
  verificationResult     String   @default("FAILED")
  verificationDetail     String   @default("")
  resolutionNotes        String?
  resolvedById           String?
  resolvedAt             DateTime?
  revisionId             String?
  revisionHash           String?
  charStart              Int?
  charEnd                Int?
  numericAtomsJson       String?
  verificationReasonCode String?
  assertionType          String?
  materiality            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  reportDraft ReportDraft @relation(fields: [reportDraftId], references: [id])
  section     ReportSection @relation(fields: [sectionId], references: [id])
  @@index([tenantId])
  @@index([reportDraftId])
  @@index([sectionId])
  @@index([revisionId])
}

model ReportGenerationRun {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  draftId           String
  snapshotJson      String   @db.Text
  createdAt         DateTime @default(now())

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  reportDraft     ReportDraft     @relation(fields: [draftId], references: [id])
  @@index([tenantId])
  @@index([reportingPeriodId])
  @@index([draftId])
}

model DonorTemplateMapping {
  id                  String    @id
  tenantId            String
  templateId          String
  version             Int       @default(1)
  regionsJson         String    @default("[]")
  detectedRegionsJson String    @default("[]")
  templatedFileUrl    String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([tenantId, templateId, version])
  @@index([tenantId])
  @@index([templateId])
}

// Professional donor reporting — revision integrity, requirement packs, and
// submission snapshots.
model ReportRevision {
  id              String   @id
  tenantId        String
  draftId         String
  sectionId       String
  revisionNumber  Int
  parentRevisionId String?
  content         String   @db.Text
  contentHash     String
  changeOrigin    String
  actorId         String
  modelId         String?
  promptVersion   Int?
  generationRunId String?
  assuranceState  String   @default("UNASSESSED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  section ReportSection @relation(fields: [sectionId], references: [id])
  @@unique([tenantId, sectionId, revisionNumber])
  @@index([tenantId])
  @@index([draftId])
  @@index([sectionId])
}

model SubmissionSnapshot {
  id                String   @id
  tenantId          String
  projectId         String
  reportDraftId     String
  reportingPeriodId String
  status            String   @default("SEALED")
  propsJson         String   @db.Text
  createdAt         DateTime @default(now())
  sealedAt          DateTime @default(now())

  @@index([tenantId])
  @@index([reportDraftId])
  @@index([reportingPeriodId])
}

model ReportingRequirementPack {
  id              String   @id
  tenantId        String?
  donorKey        String
  mechanismKey    String
  reportType      String
  version         Int      @default(1)
  language        String   @default("en")
  name            String
  status          String   @default("DRAFT")
  requirementsJson String  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, donorKey, mechanismKey, reportType, version])
  @@index([tenantId])
  @@index([donorKey, mechanismKey, reportType])
}

model AwardReportingOverride {
  id                 String   @id
  tenantId           String
  projectId          String
  awardId            String
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  documentHash       String?
  version            Int      @default(1)
  status             String   @default("DRAFT")
  requirementsJson   String   @db.Text
  sourceReferenceJson String  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, projectId, awardId, version])
  @@index([tenantId])
  @@index([projectId])
}

model ResolvedReportingRequirements {
  id                String   @id
  tenantId          String
  reportingPeriodId String
  generationRunId   String?
  snapshotJson      String   @db.Text
  sourceTraceJson   String   @db.Text
  coverageJson      String   @db.Text
  resolvedAt        DateTime
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ChecklistItem {
  id                String   @id
  tenantId          String
  projectId         String
  reportingPeriodId String
  type              String
  title             String
  description       String   @default("")
  severity          String
  relatedEntityType String?
  relatedEntityId   String?
  assignedToId      String?
  /// The person who attested to this item (set when an attestation is resolved).
  attestedById      String?
  dueDate           DateTime?
  status            String   @default("OPEN")
  resolutionNotes   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  @@index([tenantId])
  @@index([reportingPeriodId])
}

model ExportPackage {
  id                  String   @id
  tenantId            String
  projectId           String
  reportingPeriodId   String
  exportType          String
  exportIntent        String   @default("INTERNAL_REVIEW")
  submissionSnapshotId String?
  fileUrl             String
  version             Int
  exportedById        String
  includedFiles       String   @default("[]")
  createdAt           DateTime @default(now())

  project         Project         @relation(fields: [projectId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  @@index([tenantId])
}

model Comment {
  id              String   @id
  tenantId        String
  entityType      String
  entityId        String
  commentText     String
  authorId        String
  mentionedUserId String?
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([entityType, entityId])
}

model Notification {
  id                String   @id
  tenantId          String
  recipientId       String
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([recipientId])
}

model AuditEvent {
  id          String   @id
  tenantId    String
  actorId     String
  eventType   String
  entityType  String
  entityId    String
  projectId   String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  systemNote  String?
  prevHash    String   @default("")
  hash        String   @default("")
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

model LlmModel {
  id          String   @id
  name        String
  provider    String   // openai | anthropic | bedrock | ollama
  version     String
  capabilities String  // JSON array: ["chat", "embedding", "vision"]
  costPer1kTokens Float @default(0)
  maxTokens   Int     @default(4096)
  jurisdiction String  @default("US") // US | EU | AFRICA | ASIA
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  llmRuns     LlmRun[]
  prompts     LlmPrompt[]

  @@index([provider])
  @@index([jurisdiction])
}

model LlmPrompt {
  id          String   @id
  name        String   // e.g., "evidence-tagger", "report-drafter"
  version     Int      @default(1)
  promptText  String   @db.Text
  variables   String   // JSON array of variable names
  modelId     String?
  model       LlmModel? @relation(fields: [modelId], references: [id])
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  llmRuns     LlmRun[]
  feedback    LlmFeedback[]

  @@unique([name, version])
  @@index([name])
}

model LlmRun {
  id              String   @id
  modelId         String
  model           LlmModel @relation(fields: [modelId], references: [id])
  promptId       String
  prompt          LlmPrompt @relation(fields: [promptId], references: [id])
  tenantId       String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  costUsd         Float    @default(0)
  latencyMs       Int      @default(0)
  status          String   @default("success") // success | error | timeout
  errorMessage    String?
  responseText    String?  @db.Text
  promptVersion   Int
  modelVersion    String
  operationType   String?  // REPORT_DRAFT | EVIDENCE_TAG | ACTIVITY_POLISH
  resourceId      String?  // report draft / evidence / activity id
  billableUnits   Int      @default(0)
  requestId       String?  // caller idempotency key
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, operationType, createdAt])
  @@index([resourceId])
  @@index([requestId])
  @@index([modelId])
  @@index([promptId])
  @@index([createdAt])
}

model LlmFeedback {
  id          String   @id
  promptId    String
  prompt      LlmPrompt @relation(fields: [promptId], references: [id])
  tenantId    String
  runId       String?
  taskType    String   // evidence_tagging | report_draft | activity_polish
  entityType  String?  // evidence | report_section | activity_update
  entityId    String?
  accepted    Boolean
  rating      Int?     // 1-5 optional rating
  comment     String?
  modelId     String?
  promptVersion Int?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([taskType])
  @@index([entityType, entityId])
  @@index([accepted])
}

model EvidenceChunk {
  id          String   @id
  evidenceId  String
  tenantId    String
  chunkIndex  Int
  text        String   @db.Text
  tokenCount  Int      @default(0)
  createdAt   DateTime @default(now())

  embeddings  EvidenceEmbedding[]

  @@index([evidenceId])
  @@index([tenantId])
}

model EvidenceEmbedding {
  id          String   @id
  chunkId     String
  chunk       EvidenceChunk @relation(fields: [chunkId], references: [id])
  tenantId    String
  modelId     String
  provider    String
  vector      String   // JSON array of floats (stored as string for pgvector compatibility)
  dimensions  Int
  createdAt   DateTime @default(now())
  embedding   Unsupported("vector(1536)")? // pgvector column managed via raw SQL (see infra/postgres/pgvector.sql)

  @@index([chunkId])
  @@index([tenantId])
}

////////////////////////////////////////////////////////////////////////////////
// PHASE 5: Enterprise & Sector Intelligence
////////////////////////////////////////////////////////////////////////////////

model SectorTemplatePack {
  id              String   @id
  tenantId        String
  organizationId  String
  name            String
  sector          String   // NUTRITION | FOOD_SECURITY | WASH | HEALTH | PROTECTION | EDUCATION | LIVELIHOODS | SHELTER | MULTI_SECTOR | OTHER
  version         Int      @default(1)
  description     String
  donorName       String
  reportType      String
  language        String   @default("en")
  status          String   @default("DRAFT") // DRAFT | PUBLISHED | DEPRECATED
  indicatorTemplatesJson String @default("[]") // JSON array of IndicatorTemplate
  logframeTemplatesJson String @default("[]") // JSON array of LogframeNodeTemplate
  complianceTemplatesJson String @default("[]") // JSON array of ComplianceChecklistTemplate
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([organizationId])
  @@index([sector])
  @@index([status])
}

model ProjectRiskTrend {
  id                    String   @id
  tenantId              String
  projectId             String
  periodStart           DateTime
  periodEnd             DateTime
  riskScore             Int      @default(0)
  riskLevel             String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  contributingFactorsJson String @default("[]") // JSON array of RiskFactor
  missingEvidenceCount  Int      @default(0)
  deadlineSlipsCount    Int      @default(0)
  overdueChecklistItemsCount Int @default(0)
  lastUpdated           DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([tenantId])
  @@index([projectId])
  @@index([riskLevel])
  @@index([tenantId, riskLevel])
}

model OrganizationBranding {
  id                    String   @id
  tenantId              String
  organizationId        String   @unique
  enabled               Boolean  @default(true)
  subdomain             String?
  brandingConfigJson    String   @default("{}") // JSON: { logoUrl, faviconUrl, brandColorPrimary, brandColorSecondary, brandColorAccent, fontFamilyHeading, fontFamilyBody, emailSenderName, emailSenderAddress, customDomain, customDomainVerified, privacyPolicyUrl, termsOfServiceUrl }
  dmarCStatus           String   @default("none") // pending | valid | invalid | none
  dkimStatus            String   @default("pending")
  spfStatus             String   @default("pending")
  customSSLCert         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
}

model LessonPattern {
  id                  String   @id
  tenantId            String
  sector              String   // NUTRITION | FOOD_SECURITY | WASH | HEALTH | PROTECTION | EDUCATION | LIVELIHOODS | SHELTER | MULTI_SECTOR | OTHER
  donorName           String
  patternType         String   // recurring_challenge | mitigation_success | best_practice | risk_signal
  title               String
  description         String
  frequency           Int      @default(1)
  projectsAffectedJson String @default("[]") // JSON array of project IDs
  mitigationStrategiesJson String @default("[]") // JSON array of mitigation strategy descriptions
  evidenceReferencesJson String @default("[]") // JSON array of evidence IDs
  firstObserved       DateTime
  lastObserved        DateTime
  confidence          Int      @default(0) // 0-100
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([sector])
  @@index([donorName])
  @@index([patternType])
  @@index([tenantId, sector, donorName])
}

model ABACFieldPolicy {
  id                  String   @id
  tenantId            String
  organizationId      String
  role                String   // Role to which policy applies
  resourceType        String   // Project | ActivityUpdate | Indicator | EvidenceFile | etc.
  fieldPoliciesJson   String   // JSON array of FieldPolicy { fieldPath, permission, conditions }
  priority            Int      @default(0) // Higher priority wins when multiple policies match
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, organizationId, role, resourceType])
  @@index([tenantId])
  @@index([resourceType])
}

model MultiRegionBookmark {
  id                  String   @id
  tenantId            String
  region              String   // us-east-1 | eu-west-1 | af-south-1 | ap-southeast-1
  entityType          String   // The type of entity being tracked
  entityId            String
  vectorClockJson     String   @default("[]") // JSON array of VectorClock { region, timestamp, counter }
  lastSyncedAt        DateTime
  syncStatus          String   @default("active") // active | syncing | error
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, region, entityType, entityId])
  @@index([tenantId])
  @@index([entityType, entityId])
}

model IdempotencyRecord {
  id         String   @id
  tenantId   String
  key        String
  jobName    String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, jobName])
}

/// A create request a client may safely repeat: the first response is stored and replayed for the same key, so a double
/// click or a retry after a timeout never creates a second record. Scoped by tenant + user + route; expires after 24 hours.
model RequestIdempotency {
  id          String   @id
  tenantId    String
  userId      String
  route       String
  key         String
  /// PENDING while the first request runs, DONE once its response is stored.
  state       String   @default("PENDING")
  statusCode  Int?
  responseJson String? @db.Text
  contentType String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@unique([tenantId, userId, route, key])
  @@index([tenantId])
  @@index([createdAt])
}

////////////////////////////////////////////////////////////////////////////////
// FEATURE 19: Tiers, entitlements, and payments
////////////////////////////////////////////////////////////////////////////////

model BillingSubscription {
  id                     String   @id
  tenantId               String
  provider               String   @default("CREEM")
  providerCustomerId     String
  providerSubscriptionId String
  providerProductId      String
  planCode               String
  catalogVersion         Int      @default(1)
  status                 String   @default("ACTIVE") // ACTIVE | TRIALING | PAST_DUE | UNPAID | CANCELLED | EXPIRED | PAUSED
  currency               String   @default("USD")
  unitAmountMinor        Int      @default(0)
  billingInterval        String   @default("MONTH") // MONTH | YEAR
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  canceledAt             DateTime?
  graceEndsAt            DateTime?
  providerUpdatedAt      DateTime?
  lastSyncedAt           DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([tenantId, status])
  @@index([tenantId, providerCustomerId])
  @@index([providerSubscriptionId])
}

model EntitlementGrant {
  id                     String   @id
  tenantId               String
  planCode               String
  source                 String   // DEFAULT | TRIAL | CREEM_SUBSCRIPTION | ENTERPRISE_CONTRACT | GRANDFATHERED | MANUAL
  effectiveFrom          DateTime
  effectiveUntil         DateTime?
  billingSubscriptionId  String?
  overrideLimitsJson     String?  // JSON PlanLimitsJson (enterprise/grandfather)
  reason                 String?
  createdById            String?
  createdAt              DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, source])
  @@index([tenantId, effectiveFrom, effectiveUntil])
  @@index([billingSubscriptionId])
}

// Global (platform-wide) tier catalog overrides. Written by the SuperAdmin
// "Tier management" portal; entitlement resolution merges these on top of the
// static PLAN_CATALOG so edited allocations apply everywhere immediately.
model PlanCatalogOverride {
  planCode               String   @id
  name                   String?
  monthlyPriceUsd        Int?
  annualPriceUsd         Int?
  trialDays              Int?
  enabled                Boolean  @default(true)
  limitsJson             String?  // JSON PlanLimitsJson (partial/full limits override)
  createdById            String?
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([enabled])
}

model BillingEventInbox {
  id                String   @id
  provider          String   @default("CREEM")
  providerEventId   String
  eventType         String
  providerCreatedAt DateTime?
  tenantId          String?
  payloadChecksum   String
  status            String   @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | FAILED | IGNORED
  attemptCount      Int      @default(0)
  lastError         String?
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerEventId])
  @@index([status])
  @@index([tenantId])
  @@index([createdAt])
}

model UsageCounter {
  id          String   @id
  tenantId    String
  metric      String   // MANAGED_STORAGE_BYTES | AI_DRAFT_CREDITS
  periodStart DateTime
  used        BigInt   @default(0)
  reserved    BigInt   @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId, metric])
}

model TrialIdentity {
  id                String   @id
  tenantId          String
  emailFingerprint  String
  domainFingerprint String
  trialStartedAt    DateTime
  trialEndedAt      DateTime?
  createdAt         DateTime @default(now())

  @@unique([emailFingerprint])
  @@index([domainFingerprint])
  @@index([tenantId])
}

/// A one-off AI-credit top-up purchase (Phase 22 WS-D). Plan-agnostic: draws
/// down after the tenant's monthly plan allowance, oldest-first, and outlives
/// the subscription that was active when it was purchased.
model PurchasedCreditPack {
  id              String    @id
  tenantId        String
  credits         Int
  used            Int       @default(0)
  /// ACTIVE | EXHAUSTED | REFUNDED | SUSPENDED (SUSPENDED: a GROWTH_STANDING_BALANCE
  /// pack that stopped drawing down after a downgrade/cancellation away from GROWTH)
  status          String    @default("ACTIVE")
  /// TOPUP | GROWTH_STANDING_BALANCE — see PurchasedCreditPackSource
  source          String    @default("TOPUP")
  providerOrderId String?
  purchasedAt     DateTime  @default(now())
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([providerOrderId])
  @@index([tenantId, status])
  @@index([tenantId, source, status])
}

// --------------------------------------------------------------------------- //
// AI Reporter 2 — typed artifact storage (additive, RLS-scoped)
// --------------------------------------------------------------------------- //

/// One row per typed artifact produced by the AI Reporter (table, chart, list,
/// key/value, Q&A, delta). Always tenant-scoped; RLS forces the same.
model ReportArtifact {
  id           String   @id
  tenantId     String
  sectionId    String
  revisionId   String?
  /// TABLE | CHART | LIST | KEY_VALUE | QA | DELTA
  kind         String
  ordinal      Int      @default(0)
  caption      String?
  /// Kind-specific payload as JSON.
  payloadJson  String   @default("{}")
  /// Source references for the artifact as a whole (e.g. chart caption).
  sourceRefsJson String @default("[]")
  createdAt    DateTime @default(now())

  section  ReportSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rows     ReportArtifactRow[]
  @@index([tenantId])
  @@index([sectionId])
  @@index([revisionId])
}

/// Rows for TABLE and LIST artifacts. Carries per-row source references so the
/// read API can render every cell with a citation chip.
model ReportArtifactRow {
  id          String   @id
  tenantId    String
  artifactId  String
  ordinal     Int      @default(0)
  cellsJson   String   @default("[]")
  sourceRefsJson String @default("[]")

  artifact ReportArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([artifactId])
}

// --------------------------------------------------------------------------- //
// Agent Memory — learned tenant/donor style guidance (additive, RLS-scoped)
// --------------------------------------------------------------------------- //

/// One learned or proposed style/terminology statement. Never stores facts,
/// figures, or claims — only narrative style guidance, gated by human review.
model AgentMemory {
  id              String   @id
  tenantId        String
  scope           String   // ORGANIZATION | DONOR | TEMPLATE | SECTION_TYPE
  scopeId         String?
  category        String   // TONE | STRUCTURE | TERMINOLOGY | FORMATTING | LENGTH
  statement       String
  confidence      String   // LOW | MEDIUM | HIGH
  status          String   // PROPOSED | ACTIVE | REJECTED | SUPERSEDED | DEACTIVATED
  provenanceJson  String   @default("[]")
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, scope, scopeId, status])
}

/// Budget and expenditure for one reporting period (finance data mode TYPED or IMPORT).
/// Amounts are decimal strings; only a VERIFIED summary is ever sent to a report writer.
model PeriodFinancialSummary {
  id                 String    @id
  tenantId           String
  projectId          String
  reportingPeriodId  String    @unique
  currency           String
  budget             String
  expenditure        String
  committed          String?
  /// FinanceLine[] as JSON: { budgetLine, budget, expenditure, committed? }
  linesJson          String    @default("[]")
  /// TYPED | IMPORT
  source             String
  sourceNote         String?
  /// DRAFT | VERIFIED
  verificationStatus String    @default("DRAFT")
  verifiedById       String?
  verifiedAt         DateTime?
  createdById        String
  updatedById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([projectId])
}

////////////////////////////////////////////////////////////////////////////////
// PHASE 28: Work plan (planned activities and their history)
////////////////////////////////////////////////////////////////////////////////

/// Work planned ahead. Dates are plain calendar days (@db.Date). The delivery state is derived, never stored.
model PlannedActivity {
  id                 String    @id
  tenantId           String
  projectId          String
  title              String
  description        String    @default("")
  location           String?
  logframeActivityId String?
  outputId           String?
  ownerUserId        String?
  /// JSON array of user ids.
  supportUserIds     String    @default("[]")
  plannedStart       DateTime  @db.Date
  plannedEnd         DateTime  @db.Date
  /// The first dates saved; never changed afterwards.
  originalStart      DateTime  @db.Date
  originalEnd        DateTime  @db.Date
  targetParticipants Int?
  targetCount        Int?
  /// How heavy the activity is for its lead, 1 to 5. The workload view adds these up.
  effort             Int      @default(1)
  status             String    @default("PLANNED")
  statusReason       String?
  seriesId           String?
  recurrenceJson     String?
  /// Files the work needs (Batch 28.6).
  evidenceRequirementsJson String @default("[]")
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId, plannedStart])
  @@index([tenantId, ownerUserId])
  @@index([seriesId])
}

/// Append-only history of changes to a planned activity; the reasons are the project's decision history.
model PlannedActivityDependency {
  id            String   @id
  tenantId      String
  projectId     String
  predecessorId String
  successorId   String
  createdById   String
  createdAt     DateTime @default(now())

  @@unique([predecessorId, successorId])
  @@index([tenantId, projectId])
  @@index([tenantId, successorId])
}

model ProjectField {
  id          String   @id
  tenantId    String
  projectId   String
  key         String
  label       String
  type        String
  choicesJson String   @default("[]")
  createdById String
  createdAt   DateTime @default(now())

  @@unique([projectId, key])
  @@index([tenantId, projectId])
}

/// A value a person typed for a custom field on a planned activity. A blank value is no row, never a zero.
model CustomFieldValue {
  id          String   @id
  tenantId    String
  projectId   String
  fieldId     String
  entityId    String
  value       String
  updatedById String
  updatedAt   DateTime

  @@unique([fieldId, entityId])
  @@index([tenantId, entityId])
}

/// A budget line on a planned activity. Money in minor units (cents) as a whole number.
model BudgetLine {
  id                String   @id
  tenantId          String
  projectId         String
  plannedActivityId String
  code              String
  category          String
  description       String   @default("")
  donorName         String   @default("")
  currency          String
  amountMinor       Int
  createdById       String
  createdAt         DateTime @default(now())

  @@index([tenantId, plannedActivityId])
  @@index([tenantId, projectId])
}

/// An expense booked against one budget line.
model BudgetExpense {
  id           String   @id
  tenantId     String
  projectId    String
  budgetLineId String
  expenseDate  DateTime @db.Date
  amountMinor  Int
  description  String   @default("")
  createdById  String
  createdAt    DateTime @default(now())

  @@index([tenantId, budgetLineId])
  @@index([tenantId, projectId])
}

/// How many planned activities a person can lead in a week. Blank (null) means no limit has been set.
model MemberCapacity {
  id                String   @id
  tenantId          String
  userId            String
  activitiesPerWeek Int?
  updatedById       String
  updatedAt         DateTime

  @@unique([tenantId, userId])
}

/// An automation rule a project has switched on or off. No row means the rule's default (on).
model ProjectAutomation {
  id          String   @id
  tenantId    String
  projectId   String
  ruleKey     String
  enabled     Boolean
  /// The numbers the project set for this rule, as JSON (name -> whole number). Null means the rule's defaults.
  settingsJson String?
  updatedById String
  updatedAt   DateTime

  @@unique([projectId, ruleKey])
  @@index([tenantId, projectId])
}

/// A person a project reaches, by case code only (no name, phone or ID number). Consent is recorded when they are added.
model Beneficiary {
  id                  String   @id
  tenantId            String
  projectId           String
  caseCode            String
  sex                 String
  ageGroup            String
  location            String   @default("")
  enrolledOn          DateTime @db.Date
  consentRecordedById String
  createdById         String
  createdAt           DateTime @default(now())

  @@unique([projectId, caseCode])
  @@index([tenantId, projectId])
}

/// An indicator a planned activity reports on. Its breakdown fields are shown in the progress log.
model PlannedActivityIndicator {
  id                String   @id
  tenantId          String
  projectId         String
  plannedActivityId String
  indicatorId       String
  createdById       String
  createdAt         DateTime @default(now())

  @@unique([plannedActivityId, indicatorId])
  @@index([tenantId, projectId])
}

/// One progress record for a planned activity: a day, a week, a month, or the activity end.
/// valuesJson: {total, breakdowns:{key:n}, sessions, unique}. narrativeJson: free text. Blank figures are null.
model ProgressEntry {
  id                String   @id
  tenantId          String
  projectId         String
  plannedActivityId String
  kind              String
  fromDate          DateTime @db.Date
  toDate            DateTime @db.Date
  valuesJson        String
  narrativeJson     String   @default("{}")
  absorbedById      String?
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@unique([plannedActivityId, kind, fromDate])
  @@index([tenantId, plannedActivityId])
}

/// The column mapping a project saves for KoboToolbox/ODK imports (field name -> the file's column header).
model ProjectSubmissionMapping {
  id          String   @id
  tenantId    String
  projectId   String   @unique
  mappingJson String
  updatedById String
  updatedAt   DateTime

  @@index([tenantId])
}

/// A person (by case code) an activity reached. Counted once per activity.
model BeneficiaryActivityLink {
  id                String   @id
  tenantId          String
  projectId         String
  plannedActivityId String
  beneficiaryId     String
  createdById       String
  createdAt         DateTime @default(now())

  @@unique([plannedActivityId, beneficiaryId])
  @@index([tenantId, beneficiaryId])
}

model PlanRevision {
  id                String   @id
  tenantId          String
  projectId         String
  plannedActivityId String
  changeJson        String   @db.Text
  reason            String?
  changedById       String
  changedAt         DateTime @default(now())

  @@index([tenantId, plannedActivityId])
  @@index([tenantId, projectId, changedAt])
}

/// A request: one person asking another for something in a project. STATE kinds close themselves from the records.
model ProjectTask {
  id                String    @id
  tenantId          String
  projectId         String
  kind              String
  subjectType       String?
  subjectId         String?
  reportingPeriodId String?
  title             String
  details           String?
  assigneeId        String
  assignedById      String
  dueDate           DateTime  @db.Date
  urgent            Boolean   @default(false)
  status            String    @default("OPEN")
  completedById     String?
  completedAt       DateTime?
  completionNote    String?
  closedByData      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId, assigneeId, status])
  @@index([tenantId, projectId, status])
  @@index([subjectType, subjectId])
}

/// What the reminder timer has already sent, so the hourly run never repeats a summary or an escalation.
model ReminderLedgerEntry {
  id          String   @id
  tenantId    String
  recipientId String
  /// "summary" for the daily summary, an assignment key for an escalation.
  subjectKey  String
  ruleKey     String
  sentOn      DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([tenantId, recipientId, subjectKey, ruleKey, sentOn])
  @@index([tenantId, recipientId, subjectKey])
}

/// Problems and risks: a short list. Never part of a donor report.
model ProjectRisk {
  id                String    @id
  tenantId          String
  projectId         String
  kind              String
  title             String
  seriousness       String
  ownerId           String?
  action            String    @default("")
  status            String    @default("OPEN")
  closedNote        String?
  closedById        String?
  closedAt          DateTime?
  plannedActivityId String?
  raisedById        String
  reviewBy          DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId, status])
  @@index([tenantId, ownerId, status])
}

/// A job the API could not hand to the queue (Kestra down, network error). Kept so it is retried with backoff and, after
/// the last attempt, dead-lettered where it can be seen, instead of being logged and lost.
model JobOutbox {
  id            String   @id
  tenantId      String
  jobName       String
  payloadJson   String   @db.Text
  status        String   @default("PENDING") // PENDING | DONE | DEAD
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([tenantId])
}

/// The results framework of a project as it stood after one change: append-only, so a target that moved, or a report
/// approved against an earlier framework, can be shown. `approvedAt` marks a version a person signed off as the agreed one.
model LogframeVersion {
  id           String    @id
  tenantId     String
  projectId    String
  version      Int
  snapshotJson String    @db.Text
  contentHash  String
  summary      String
  createdById  String
  createdAt    DateTime  @default(now())
  approvedById String?
  approvedAt   DateTime?

  @@unique([tenantId, projectId, version])
  @@index([tenantId, projectId])
}

/// A programme groups related grants and projects (a country programme, a thematic portfolio).
model Programme {
  id          String   @id
  tenantId    String
  name        String
  code        String?
  description String?
  status      String   @default("ACTIVE") // ACTIVE | CLOSED
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A funding award: who funds, how much, for how long. Projects delivered under it point at it.
model Grant {
  id          String    @id
  tenantId    String
  programmeId String?
  title       String
  donorName   String
  awardNumber String?
  amount      String? // decimal string, with currency
  currency    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("ACTIVE") // ACTIVE | CLOSED
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, programmeId])
}

