{
  "openapi": "3.1.0",
  "info": {
    "title": "DonorDesk Public API",
    "version": "3.007",
    "description": "Read-only access to a project's data for systems the organisation trusts. Authenticate with an API key sent as `Authorization: Bearer dd_live_...`. A key has scopes (`projects:read`, `indicators:read`, `places:read`) and may be limited to chosen projects; it can expire or be revoked. Refusals say only \"not allowed\" (401 when the key is missing, revoked or expired; 403 when it lacks the scope or the project). Finance figures are never served. A missing value is absent, never zero. Values marked not verified are drafts. Rate limits: 10 requests a second per key at the proxy, and 120 a minute per key inside the API (429 with `Retry-After`).\n\nThe same keys also work with the Model Context Protocol at `POST /api/v1/mcp` (tag `mcp`).",
    "contact": {
      "name": "DonorDesk Support",
      "email": "api@donordesk.org"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://donordesk.online/terms"
    }
  },
  "servers": [
    {
      "url": "https://donordesk.online/api/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "projects"
    },
    {
      "name": "indicators"
    },
    {
      "name": "places"
    },
    {
      "name": "mcp"
    }
  ],
  "security": [
    {
      "bearerKey": []
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "operationId": "listProjects",
        "summary": "List the projects this key may read",
        "responses": {
          "200": {
            "description": "The projects the key may see.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "donor": {
                            "type": "string"
                          },
                          "country": {
                            "type": "string"
                          },
                          "sector": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "startDate": {
                            "type": "string",
                            "format": "date"
                          },
                          "endDate": {
                            "type": "string",
                            "format": "date"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/indicators": {
      "get": {
        "tags": [
          "indicators"
        ],
        "operationId": "getProjectIndicators",
        "summary": "Indicator definitions, periods and recorded values",
        "description": "The project's data sheet without finance: indicators (code, name, unit, baseline, target), reporting periods, and every recorded cell with its verification status. A not-applicable answer has no figures.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The data sheet.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "projectId": {
                      "type": "string"
                    },
                    "periods": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "indicators": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "cells": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The key may not read indicators for this project.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/place-results": {
      "get": {
        "tags": [
          "places"
        ],
        "operationId": "getProjectPlaceResults",
        "summary": "Indicator results rolled up by place",
        "description": "Additive types sum up the place tree. A rate is shown only for the place that recorded it and is never combined. Typed locations that match no place, several places, or a bigger area than the level are listed as unplaced.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4,
              "default": 1
            },
            "description": "0 country, 1 region, 2 district, 3 sub-district, 4 site."
          }
        ],
        "responses": {
          "200": {
            "description": "Results by place at the chosen level."
          },
          "401": {
            "description": "No valid key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The key may not read places for this project.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": [
          "mcp"
        ],
        "operationId": "mcp",
        "summary": "Model Context Protocol (JSON-RPC 2.0 over POST)",
        "description": "Tools only: `list_projects`, `get_indicator_values`, `get_results_by_place`. The tools offered are those the key's scopes allow. A batch holds 1 to 20 messages. A notification gets no answer (202).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "jsonrpc": {
                        "const": "2.0"
                      },
                      "id": {
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      "method": {
                        "type": "string",
                        "enum": [
                          "initialize",
                          "ping",
                          "tools/list",
                          "tools/call"
                        ]
                      },
                      "params": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "jsonrpc",
                      "method"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response, or an array for a batch."
          },
          "202": {
            "description": "A notification was received; nothing to return."
          },
          "401": {
            "description": "No valid key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "title",
                    "status"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "mcp"
        ],
        "operationId": "mcpGet",
        "summary": "Not supported; use POST",
        "responses": {
          "405": {
            "description": "Use POST."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "dd_live_...",
        "description": "An API key created in Settings → Integrations. Shown once."
      }
    }
  }
}
